---
import type { Dict } from '../i18n';
interface Props { t: Dict; }
const { t } = Astro.props;
---
<section class="jargon" id="jargon" aria-labelledby="jargon-titre">
  <div class="wrap jg-grid">
    <div class="jg-copy" data-reveal>
      <h2 id="jargon-titre">{t.jargon.title}</h2>
      <p>{t.jargon.intro}</p>
    </div>
    <div class="jg-card" data-reveal id="jg-card">
      <div class="jg-bar">
        <span>{t.jargon.bar}</span>
        <div class="jg-toggle" role="group" aria-label={t.jargon.toggleLabel}>
          <button type="button" aria-pressed="true" data-jg="jargon">{t.jargon.inJargon}</button>
          <button type="button" aria-pressed="false" data-jg="fr">{t.jargon.inPlain}</button>
        </div>
      </div>
      <ul class="jg-list">
            <li><span class="jg-k"><abbr title="Return on investment">ROI</abbr><b>{t.jargon.roiValue}</b></span><span class="jg-t"><span class="def">{t.jargon.roiDef}</span><span class="say" data-scramble>{t.jargon.roiSay}</span></span></li>
            <li><span class="jg-k"><abbr title="Return on ad spend">ROAS</abbr><b>{t.jargon.roasValue}</b></span><span class="jg-t"><span class="def">{t.jargon.roasDef}</span><span class="say" data-scramble>{t.jargon.roasSay}</span></span></li>
            <li><span class="jg-k"><abbr title="Cost per acquisition">CPA</abbr><b>{t.jargon.cpaValue}</b></span><span class="jg-t"><span class="def">{t.jargon.cpaDef}</span><span class="say" data-scramble>{t.jargon.cpaSay}</span></span></li>
            <li><span class="jg-k"><abbr title="Cost per mille">CPM</abbr><b>{t.jargon.cpmValue}</b></span><span class="jg-t"><span class="def">{t.jargon.cpmDef}</span><span class="say" data-scramble>{t.jargon.cpmSay}</span></span></li>
            <li class="act"><span class="jg-k"><b>{t.jargon.todo}</b></span><span class="jg-t"><span class="def">{t.jargon.todoDef}</span><span class="say" data-scramble>{t.jargon.todoSay}</span></span></li>
      </ul>
    </div>
  </div>
</section>
