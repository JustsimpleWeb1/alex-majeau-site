---
import type { Dict } from '../i18n';
interface Props { t: Dict; }
const { t } = Astro.props;
---
<section class="method" id="methode" aria-labelledby="methode-titre">
  <div class="wrap">
    <div class="sec-head" data-reveal><h2 id="methode-titre">{t.method.title}</h2></div>
    <div class="method-grid">
      <ol class="steps" data-reveal>
        <li>
          <p class="when">30&nbsp;minutes</p>
          <h3>{t.method.s1Title}</h3>
          <p>{t.method.s1Text}</p>
        </li>
        <li>
          <p class="when">{t.method.w1When}</p>
          <h3>{t.method.s2Title}</h3>
          <p>{t.method.s2Text}</p>
        </li>
        <li>
          <p class="when">{t.method.w23When}</p>
          <h3>{t.method.s3Title}</h3>
          <p>{t.method.s3Text}</p>
        </li>
        <li>
          <p class="when">{t.method.monthlyWhen}</p>
          <h3>{t.method.s4Title}</h3>
          <p>{t.method.s4Text}</p>
        </li>
      </ol>
      <div class="report-wrap" data-reveal>
        <p class="report-cap">{t.method.reportCap}</p>
        <span class="sample">{t.method.sample}</span>
        <div class="report">
          <div class="rp-head"><strong>{t.hero.t4Title}</strong><span>{t.services.yourStore}</span></div>
          <div class="kpis">
            <div><span>{t.method.kpiSpent}</span><b data-to="4200" data-pre={t.method.moneyPre} data-suf={t.method.moneySuf}>{t.method.kpiSpentValue}</b></div>
            <div><span>{t.method.kpiSales}</span><b data-to="18900" data-pre={t.method.moneyPre} data-suf={t.method.moneySuf}>{t.method.kpiSalesValue}</b></div>
            <div><span>{t.method.kpiReturn}</span><b data-to="450" data-suf={t.method.pctSuf}>{t.method.kpiReturnValue}</b></div>
          </div>
          <div class="rp-chart">
            <svg viewBox="0 0 400 120" aria-hidden="true">
              <defs><linearGradient id="area" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3AA8FF" stop-opacity=".75"/><stop offset="1" stop-color="#3AA8FF" stop-opacity="0"/></linearGradient></defs>
              <g stroke="#E9E6DD" stroke-width="1"><line x1="0" y1="20" x2="400" y2="20"/><line x1="0" y1="55" x2="400" y2="55"/><line x1="0" y1="90" x2="400" y2="90"/></g>
              <path d="M0 96 L57 88 L114 92 L171 70 L228 62 L285 44 L342 38 L400 22 L400 110 L0 110 Z" fill="url(#area)" class="area"/>
              <path d="M0 96 L57 88 L114 92 L171 70 L228 62 L285 44 L342 38 L400 22" fill="none" stroke="#101311" stroke-width="2.5" stroke-linejoin="round" class="line"/>
              <circle cx="400" cy="22" r="5" fill="#101311" class="dot"/>
              <g font-family="IBM Plex Mono, monospace" font-size="10" fill="#676C68"><text x="0" y="108">{t.method.wk1}</text><text x="352" y="108">{t.method.wk4}</text></g>
            </svg>
          </div>
          <div class="rp-next">
            <p>{t.method.next}</p>
            <ul>
              <li>{t.method.next1}</li>
              <li>{t.method.next2}</li>
              <li>{t.method.next3}</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
