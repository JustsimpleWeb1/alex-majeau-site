---
import type { Dict } from '../i18n';
interface Props { t: Dict; }
const { t } = Astro.props;
---
<section class="results" id="resultats" aria-labelledby="resultats-titre">
  <div class="wrap">
    <div class="panel on-dark" data-reveal>
      <div class="sec-head" style="margin-bottom:0"><span class="label">{t.results.label}</span></div>
      <h2 id="resultats-titre">{t.results.title}</h2>
      <div class="bibs">
        <div class="bib">
          <span class="pin a"></span><span class="pin b"></span><span class="pin c"></span><span class="pin d"></span>
          <div class="num" data-count={t.results.num1} data-before={t.results.before1}>{t.results.before1}{t.results.num1}{t.results.after1 && <small>{t.results.after1}</small>}</div>
          <p class="what">{t.results.bib1}</p>
          <p class="plain">{t.results.bib1Plain}</p>
        </div>
        <div class="bib">
          <span class="pin a"></span><span class="pin b"></span><span class="pin c"></span><span class="pin d"></span>
          <div class="num" data-count={t.results.num2} data-before={t.results.before2}>{t.results.before2}{t.results.num2}{t.results.after2 && <small>{t.results.after2}</small>}</div>
          <p class="what">{t.results.bib2}</p>
          <p class="plain">{t.results.bib2Plain}</p>
        </div>
      </div>
      <p class="res-note">{t.results.note}</p>
      <figure class="quote">
        <blockquote><p><Fragment set:html={t.results.quoteOpen} />{t.results.quote}<Fragment set:html={t.results.quoteClose} /></p></blockquote>
        <figcaption><span class="q-avatar" aria-hidden="true"></span><span><strong>{t.results.quoteName}</strong>{t.results.quoteRole}</span></figcaption>
      </figure>
      <p class="panel-cta">{t.results.panelCta}</p>
      <a class="btn btn-hi" href="#contact">{t.cta.primary} <svg aria-hidden="true"><use href="#arrow"/></svg></a>
    </div>
  </div>
</section>
