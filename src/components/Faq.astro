---
import type { Dict } from '../i18n';
import { site } from '../site.config';
// items : questions propres à une page ajoutée (par défaut, celles de l'accueil).
interface Props { t: Dict; items?: { q: string; a: string }[] }
const { t, items = t.faq.items } = Astro.props;
---
<section class="faq" id="faq" aria-labelledby="faq-titre">
  <div class="wrap faq-grid">
    <div class="faq-intro" data-reveal>
      <div class="sec-head" style="margin-bottom:0"><h2 id="faq-titre">{t.faq.title}</h2></div>
      <p>{t.faq.intro} <a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
    <div data-reveal>
      {items.map((item, i) => (
        <details open={i === 0}><summary>{item.q}<span class="pm" aria-hidden="true"></span></summary><p>{item.a}</p></details>
      ))}
    </div>
  </div>
</section>
