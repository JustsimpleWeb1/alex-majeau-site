---
import Base from '../layouts/Base.astro';
import Sprite from './Sprite.astro';
import Header from './Header.astro';
import MobileMenu from './MobileMenu.astro';
import Hero from './Hero.astro';
import Services from './Services.astro';
import Results from './Results.astro';
import Jargon from './Jargon.astro';
import Method from './Method.astro';
import About from './About.astro';
import Faq from './Faq.astro';
import Booking from './Booking.astro';
import Footer from './Footer.astro';
import { type Lang, dictionaries, paths, otherLang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dictionaries[lang];
// Lien vers la même page dans l'autre langue (sélecteur FR / EN).
const alt = paths[otherLang(lang)];
---
<Base lang={lang}>
  <Sprite />
  <Header t={t} alt={alt} />
  <MobileMenu t={t} alt={alt} />
  <main id="main">
    <Hero t={t} />
    <Services t={t} />
    <Results t={t} />
    <Jargon t={t} />
    <Method t={t} />
    <About t={t} />
    <Faq t={t} />
    <Booking t={t} />
  </main>
  <Footer t={t} alt={alt} />
</Base>
