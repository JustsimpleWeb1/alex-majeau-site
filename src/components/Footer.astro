---
import type { Dict } from '../i18n';
import { site } from '../site.config';
import type { Lang } from '../i18n';
import { addedPages } from '../i18n/pages';
// home : adresse de l'accueil sur les autres pages, pour que les ancres y mènent (vide sur l'accueil).
interface Props { t: Dict; alt: string; home?: string; }
const { t, alt, home = '' } = Astro.props;
// Les pages ajoutées s'inscrivent toutes seules dans la colonne « Le site ».
const pages = addedPages((Astro.currentLocale ?? 'fr') as Lang);
---
<footer class="site" aria-labelledby="pied-titre">
  <h2 id="pied-titre" class="sr-only">{t.seo.serviceName}</h2>
  <div class="wrap foot-grid">
    <div class="foot-brand">
      <a class="logo" href={`${home}#top`}><span class="logo-mark" aria-hidden="true"></span>Alexandre Majeau</a>
      <p>{t.footer.about}</p>
      <a class="btn btn-hi" href={`${home}#contact`}>{t.cta.primary} <svg aria-hidden="true"><use href="#arrow"/></svg></a>
    </div>
    <nav class="foot-col" aria-label={t.footer.navLabel}>
      <p class="foot-h">{t.footer.siteHeading}</p>
      <ul>
        <li><a href={`${home}#services`}>Services</a></li>
        <li><a href={`${home}#resultats`}>{t.nav.results}</a></li>
        <li><a href={`${home}#methode`}>{t.nav.process}</a></li>
        <li><a href={`${home}#apropos`}>{t.nav.about}</a></li>
        <li><a href={`${home}#faq`}>{t.nav.faqLong}</a></li>
        {pages.map((page) => <li><a href={page.path}>{page.menu}</a></li>)}
      </ul>
    </nav>
    <div class="foot-col">
      <p class="foot-h">Services</p>
      <ul>
        <li><a href={`${home}#etape-social`}>{t.seo.svc1}</a></li>
        <li><a href={`${home}#etape-recherche`}>{t.seo.svc2}</a></li>
        <li><a href={`${home}#etape-shopping`}>{t.seo.svc3}</a></li>
        <li><a href={`${home}#etape-suivi`}>{t.seo.svc4}</a></li>
      </ul>
    </div>
    <address class="foot-col">
      <p class="foot-h">Contact</p>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.linkedin} rel="noopener" target="_blank">LinkedIn</a></li>
        <li>{t.footer.city}</li>
        <li>{t.footer.langs}</li>
      </ul>
    </address>
  </div>
  <p class="wordmark" aria-hidden="true">Alexandre Majeau</p>
  <div class="wrap foot-legal">
    <span>© 2026 Alexandre Majeau. {t.footer.rights}</span>
    <span><a href="#">{t.legal.privacy}</a> · <a href="#">{t.footer.cookies}</a></span>
    <span><a href={alt} hreflang={t.lang.code} lang={t.lang.code}>{t.lang.name}</a></span>
    <span>{t.footer.siteBy} <a href="https://justsimpleweb.com" rel="noopener">Just Simple Web</a></span>
  </div>
</footer>
