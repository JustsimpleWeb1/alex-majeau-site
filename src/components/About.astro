---
import type { Dict } from '../i18n';
import { site } from '../site.config';
interface Props { t: Dict; }
const { t } = Astro.props;
---
<section class="about" id="apropos" aria-labelledby="apropos-titre">
  <div class="wrap about-grid">
    <figure class="shot about-photo" data-reveal aria-label={t.seo.aboutPhotoAlt}>
      <span class="vf tl"></span><span class="vf tr"></span><span class="vf bl"></span><span class="vf br"></span>
      <figcaption class="cap">{t.about.photoCap}</figcaption>
    </figure>
    <div>
      <div class="sec-head" data-reveal style="margin-bottom:var(--s3)"><h2 id="apropos-titre">{t.about.title}</h2></div>
      <ol class="reasons" data-reveal>
        {t.about.reasons.map((reason) => (
          <li><div><h3>{reason.title}</h3><p>{reason.text}</p></div></li>
        ))}
      </ol>
      <ul class="facts" data-reveal>
        <li><span>Primeau Vélo</span>{t.about.fact1}</li>
        <li><span>{t.about.eduLabel}</span>{t.about.fact2}</li>
      </ul>
      <a class="link-arrow" href={site.linkedin} rel="noopener" target="_blank">{t.about.linkedin} <svg width="16" height="16" aria-hidden="true"><use href="#arrow"/></svg></a>
    </div>
  </div>
</section>
